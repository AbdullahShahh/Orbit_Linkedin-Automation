{
  "info": {
    "name": "LinkedIn Connect Bot (local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:4000/api"
    }
  ],
  "item": [
    {
      "name": "Message Types",
      "item": [
        {
          "name": "List types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/types",
              "host": [
                "{{base}}"
              ],
              "path": [
                "types"
              ]
            }
          }
        },
        {
          "name": "Create type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/types",
              "host": [
                "{{base}}"
              ],
              "path": [
                "types"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CPAs\",\n  \"template\": \"Hi {first_name}, I work with CPA firms like {company}...\\n---\\n[Hi|Hello] {first_name}, ...\",\n  \"description\": \"\"\n}"
            }
          }
        },
        {
          "name": "Update type",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/types/1",
              "host": [
                "{{base}}"
              ],
              "path": [
                "types",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bookkeepers\",\n  \"template\": \"Hi {first_name}, ...\",\n  \"description\": \"\"\n}"
            }
          }
        },
        {
          "name": "Delete type",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/types/1",
              "host": [
                "{{base}}"
              ],
              "path": [
                "types",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
