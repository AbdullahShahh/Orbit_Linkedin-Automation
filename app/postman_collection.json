    {
      "name": "Leads",
      "item": [
        {
          "name": "Search leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/leads?list_id=&status=&q=&limit=50&offset=0",
              "host": [
                "{{base}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "list_id",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Reset lead to pending",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base}}/leads/1/reset",
              "host": [
                "{{base}}"
              ],
              "path": [
                "leads",
                "1",
                "reset"
              ]
            }
          }
        },
        {
          "name": "Retry all failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/leads/reset-failed",
              "host": [
                "{{base}}"
              ],
              "path": [
                "leads",
                "reset-failed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Edit lead",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/leads/1",
              "host": [
                "{{base}}"
              ],
              "path": [
                "leads",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Mike\"\n}"
            }
          }
        },
        {
          "name": "Delete lead",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/leads/1",
              "host": [
                "{{base}}"
              ],
              "path": [
                "leads",
                "1"
              ]
            }
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [],
