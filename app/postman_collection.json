          "name": "Activate / pause list",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/lists/1/active",
              "host": [
                "{{base}}"
              ],
              "path": [
                "lists",
                "1",
