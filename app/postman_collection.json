            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"US Bookkeepers\",\n  \"url\": \"https://www.linkedin.com/sales/search/people?savedSearchId=123\",\n  \"type_id\": 1,\n  \"max_pages\": 20,\n  \"active\": true,\n  \"notes\": \"\"\n}"
