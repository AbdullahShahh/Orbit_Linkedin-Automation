{
  "manifest_version": 3,
  "name": "LinkedIn Connect Bot",
  "version": "1.0.5",
  "description": "Runs your Sales Navigator connect-with-note workflow in your own logged-in LinkedIn tab. Controlled by the local dashboard (localhost).",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost/*", "ws://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LinkedIn Connect Bot" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
