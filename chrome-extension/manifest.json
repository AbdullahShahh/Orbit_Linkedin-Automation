{
  "manifest_version": 3,
  "name": "LinkedIn Bot",
  "version": "1.0.27",
  "description": "Runs your LinkedIn outreach (connection notes, follow-ups, prospect finder) in your own logged-in Chrome. Controlled by the local dashboard (localhost).",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms", "cookies"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost/*", "ws://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LinkedIn Bot" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
